# Скопируйте этот файл в .env. Запуск --demo не требует подключения.
# Возьмите точный адрес API из вашей версии Unsloth Studio.
# Пример формата адреса: http://127.0.0.1:8000/v1 (порт 8000 — только пример).
# Пустые значения намеренны: программа не выбирает сервер/модель за вас.
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=

# Обычно локальному серверу ключ не нужен. Если нужен — храните его только в .env.
ASSISTANT_API_KEY=
ASSISTANT_TIMEOUT=60
ASSISTANT_MAX_STEPS=8
ASSISTANT_MAX_TOOL_CALLS=8
ASSISTANT_MAX_TOKENS=2048

# Суммарный объём выданного текста в режиме --describe-project, в байтах UTF-8.
# Это отдельный лимит от количества шагов и выходных токенов модели.
# Допустимо до 1048576; больший бюджет не гарантирует, что контекст модели вместит текст.
ASSISTANT_READ_BUDGET=16384
